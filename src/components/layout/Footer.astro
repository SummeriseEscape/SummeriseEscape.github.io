---
import ConstructDivider from '@/components/ui/ConstructDivider.astro';
---

<footer class="site-footer footer-construct-corner">
  <div class="footer-inner">
    <div class="footer-left">
      <strong>Starry Breeze</strong>
      <span class="mx-2" style="color: var(--border-light);">·</span>
      风吹过夏夜星辰
    </div>
    <div class="footer-right">
      <a href="#">↑ 回到顶部</a>
    </div>
  </div>
</footer>

<script>
  document.querySelector('.footer-right a')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
