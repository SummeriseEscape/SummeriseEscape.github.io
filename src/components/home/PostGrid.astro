---
import type { CollectionEntry } from 'astro:content';
import PostCard from '@/components/post/PostCard.astro';
import ConstructDivider from '@/components/ui/ConstructDivider.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<section
  class="post-grid-wrapper"
  style="max-width: 1200px; margin-inline: auto; padding: 5rem 2rem 4rem;"
>
  <!-- Section header with watermark -->
  <div class="post-grid-section-header">
    <span class="post-grid-watermark" aria-hidden="true">风辰</span>
    <span class="post-grid-label">精选</span>
  </div>

  <ConstructDivider variant="diamond" />

  <div class="post-grid-bg" style="margin-top: 3rem;">
    {posts.length > 0 ? (
      <div
        class="post-grid construct-frame"
        style="
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 2rem;
          padding: 1.5rem;
        "
      >
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            slug={post.id.replace(/\.(mdx|md)$/, '')}
            date={post.data.date}
            excerpt={post.data.excerpt}
            image={post.data.image}
            imageAlt={post.data.imageAlt}
            mood={post.data.mood}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p style="color: var(--text-muted); font-family: var(--font-sans);">
          暂无文章。在 <code>src/content/posts/</code> 中添加你的第一篇 .mdx 文件。
        </p>
      </div>
    )}
  </div>
</section>
