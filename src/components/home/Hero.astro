---
import Starfield from '@/components/ui/Starfield.astro';
import GeometricCircle from '@/components/ui/GeometricCircle.astro';
import VerticalText from '@/components/ui/VerticalText.astro';
import ScrollIndicator from '@/components/ui/ScrollIndicator.astro';
---

<section
  class="hero relative flex items-center justify-center overflow-hidden construct-diagonal"
  style="min-height: 100vh;"
>

  <!-- Starfield background -->
  <Starfield />

  <!-- Geometric decorations — asymmetrical composition -->
  <GeometricCircle size={200} top="10%" left="5%" color="var(--breeze-blue)" delay={0} duration={7} blur={4} />
  <GeometricCircle size={90} top="20%" right="10%" color="var(--summer-pink)" delay={1.5} duration={6} shape="diamond" rotation={15} />
  <GeometricCircle size={160} bottom="18%" left="12%" color="var(--dust-purple)" delay={0.8} duration={8} />
  <GeometricCircle size={55} top="55%" right="6%" color="var(--moon-beige)" delay={2.2} duration={5.5} shape="triangle" rotation={10} />
  <GeometricCircle size={110} bottom="28%" right="22%" color="var(--breeze-blue)" delay={3} duration={7.5} />
  <!-- Additional circles for richer atmosphere -->
  <GeometricCircle size={240} top="40%" left="60%" color="var(--deep-sky)" delay={1.2} duration={9} blur={8} />
  <GeometricCircle size={70} bottom="12%" right="40%" color="var(--summer-pink)" delay={2.8} duration={6.5} shape="diamond" rotation={-20} />

  <!-- Main content -->
  <div class="relative construct-corner" style="z-index: 2; max-width: 720px; padding: 0 2rem;">
    <!-- Decorative rule -->
    <div class="hero-title-rule"></div>

    <h1
      id="hero-title"
      class="font-bold m-0 tracking-wide"
      style="
        font-family: var(--font-serif);
        font-size: clamp(4rem, 10vw, 9rem);
        color: var(--night-blue);
        line-height: 1.1;
        letter-spacing: 0.05em;
      "
    >
      风辰
    </h1>
    <p
      id="hero-tagline"
      class="hero-tagline-new mt-4 m-0"
    >
      风吹过夏夜星辰
    </p>
  </div>

  <!-- Vertical text decoration -->
  <div class="absolute right-8 top-1/2" style="z-index: 2; transform: translateY(-50%);">
    <VerticalText text="夏の夜の風" />
  </div>

  <div class="absolute left-5 bottom-1/3" style="z-index: 2;">
    <VerticalText text="星空の下で" />
  </div>

  <!-- Bottom gradient line -->
  <div class="hero-bottom-line" aria-hidden="true"></div>

  <!-- Year mark -->
  <span class="hero-year-mark" aria-hidden="true">2026 · 夏</span>

  <!-- Scroll indicator -->
  <ScrollIndicator />
</section>
