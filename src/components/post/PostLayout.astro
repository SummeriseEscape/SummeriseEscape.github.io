---
import { formatDate, readingTime } from '@/utils/date';
import MoodBadge from '@/components/ui/MoodBadge.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data, body } = post;
const rawContent = body ?? '';
const readTime = readingTime(rawContent);

const categoryMap: Record<string, string> = {
  poetry: '诗歌',
  diary: '日记',
  essay: '散文',
  photography: '摄影',
  music: '音乐',
};
---

<article
  class="post-article construct-corner"
  style="max-width: 900px; margin-inline: auto; padding: 0 1.5rem 6rem;"
>
  <!-- Hero banner with cover image and title overlay -->
  <div class="post-hero-banner">
    <img
      src={data.image}
      alt={data.imageAlt}
      loading="eager"
      decoding="async"
    />
    <div class="post-hero-overlay" aria-hidden="true"></div>
    <h1 class="post-hero-title">
      {data.title}
    </h1>
  </div>

  <!-- Content area -->
  <div class="post-article-new" style="position: relative;">
    <!-- Floating content decorations -->
    <div class="post-content-decoration left" aria-hidden="true"></div>
    <div class="post-content-decoration right" aria-hidden="true"></div>

    <!-- Meta row -->
    <div class="post-meta-row-new">
      <time>{formatDate(data.date)}</time>
      <span class="post-meta-dot" aria-hidden="true"></span>
      <MoodBadge mood={data.mood} />
      <span class="post-meta-dot" aria-hidden="true"></span>
      <span>{categoryMap[data.category] ?? data.category}</span>
      <span class="post-meta-dot" aria-hidden="true"></span>
      <span>沉浸时间约 {readTime} 分钟</span>
    </div>

    <!-- Tags -->
    {data.tags && data.tags.length > 0 && (
      <div class="post-tags-new">
        {data.tags.map((tag) => (
          <span class="post-tag-new">#{tag}</span>
        ))}
      </div>
    )}

    <!-- Divider -->
    <hr class="construct-hr" />

    <!-- Content -->
    <div
      class="post-content"
      style="
        font-family: var(--font-serif);
        font-size: 1.1rem;
        line-height: 1.75;
        color: var(--text-primary);
        position: relative;
        z-index: 1;
      "
    >
      <slot />
    </div>

    <!-- Bottom divider -->
    <hr class="construct-hr" />

    <!-- Tags (bottom) -->
    {data.tags && data.tags.length > 0 && (
      <div class="post-tags-new">
        {data.tags.map((tag) => (
          <span class="post-tag-new">#{tag}</span>
        ))}
      </div>
    )}

    <!-- Back link -->
    <div>
      <a href="/posts/" class="post-back-link">
        ← 返回文章列表
      </a>
    </div>
  </div>
</article>

<style>
  .post-content p {
    margin-bottom: 1.8em;
  }
  .post-content blockquote {
    margin: 2em 0;
    padding: 1em 1.5em;
    border-left: 2px solid var(--breeze-blue);
    background: var(--bg-soft);
    font-style: italic;
    color: var(--text-secondary);
  }
  .post-content hr {
    margin: 2em 0;
    border: 0;
    height: 1px;
    background: var(--border-light);
  }
  .post-content ul, .post-content ol {
    margin-bottom: 1.8em;
    padding-left: 1.5em;
  }
  .post-content li {
    margin-bottom: 0.5em;
    color: var(--text-secondary);
  }
  .post-content strong {
    color: var(--text-primary);
  }
  .post-content em {
    color: var(--night-blue);
    font-style: italic;
  }
  .post-content img {
    max-width: 900px;
    width: 100%;
    margin: 2em auto;
    display: block;
  }
</style>
