---
import { formatDate } from '@/utils/date';
import MoodBadge from '@/components/ui/MoodBadge.astro';

interface Props {
  title: string;
  slug: string;
  date: Date;
  excerpt: string;
  image: string;
  imageAlt: string;
  mood: string;
}

const { title, slug, date, excerpt, image, imageAlt, mood } = Astro.props;
---

<article class="post-card group">
  <a href={`/posts/${slug}/`} class="block no-underline">
    <div
      class="post-card-inner overflow-hidden relative"
      style="
        background: var(--bg-soft);
        border: 1px solid var(--border-light);
        transition: transform var(--transition-slow), border-color var(--transition-medium);
      "
    >
      <!-- Dual corner brackets -->
      <span class="post-card-bracket-tr" aria-hidden="true"></span>
      <span class="post-card-bracket-bl" aria-hidden="true"></span>

      <!-- Image area with overlays -->
      <div class="post-card-image-wrap">
        <img
          src={image}
          alt={imageAlt}
          loading="lazy"
          decoding="async"
        />
        <!-- Date overlay — bottom-left -->
        <time class="post-card-date-overlay">
          {formatDate(date)}
        </time>
        <!-- Mood badge — top-right -->
        <span class="post-card-mood-badge">
          <MoodBadge mood={mood} />
        </span>
      </div>

      <!-- Content -->
      <div style="padding: 1.5rem;">
        <h3
          class="text-xl font-bold m-0"
          style="font-family: var(--font-serif); color: var(--text-primary);"
        >
          {title}
        </h3>
        <div class="post-card-title-line"></div>
        <p
          class="text-sm m-0 line-clamp-1"
          style="color: var(--text-secondary); line-height: 1.6; margin-top: 0.6rem;"
        >
          {excerpt}
        </p>
      </div>
    </div>
  </a>
</article>

<style>
  .post-card a:hover .post-card-inner {
    transform: translateY(-8px);
    border-color: var(--deep-sky);
  }
  .post-card a:hover img {
    transform: scale(1.05);
  }
</style>
