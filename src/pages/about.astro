---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import GeometricCircle from '@/components/ui/GeometricCircle.astro';
---

<BaseLayout title="关于">
  <div style="max-width: 720px; margin-inline: auto; padding: 6rem 2rem 4rem; position: relative;">

    <!-- Decorative elements -->
    <GeometricCircle size={90} top="4%" left="-8%" color="var(--breeze-blue)" delay={0} duration={7} shape="diamond" rotation={15} />
    <GeometricCircle size={55} top="18%" right="-5%" color="var(--summer-pink)" delay={1.2} duration={6} shape="triangle" rotation={10} />
    <GeometricCircle size={120} bottom="15%" left="-10%" color="var(--dust-purple)" delay={2} duration={8} shape="circle" blur={4} />
    <GeometricCircle size={60} bottom="28%" right="-6%" color="var(--breeze-blue)" delay={3} duration={6.5} shape="diamond" rotation={-15} />

    <!-- Profile card -->
    <div class="about-profile-card mb-16">
      <!-- Dot grid background -->
      <div class="dot-grid-bg">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="about-dots" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
              <circle cx="10" cy="10" r="0.5" fill="var(--text-muted)" opacity="0.3" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#about-dots)" />
        </svg>
      </div>

      <!-- Watermark -->
      <span class="about-watermark" aria-hidden="true">星风</span>

      <!-- Diagonal accent -->
      <div class="about-diagonal" aria-hidden="true"></div>

      <!-- Avatar -->
      <!-- 替换头像：将你的头像图片放到 public/images/avatar.jpg，支持 jpg/png/webp -->
      <div class="about-avatar-frame">
        <div
          style="
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, color-mix(in srgb, var(--breeze-blue) 20%, transparent), color-mix(in srgb, var(--dust-purple) 20%, transparent));
            border: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
          "
        >
          <img
            src="/images/avatar.jpg"
            alt="头像"
            style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;"
          />
        </div>
      </div>

      <h1
        class="text-4xl font-bold mb-2"
        style="font-family: var(--font-serif); color: var(--text-primary);"
      >
        Starry Breeze
      </h1>
      <p
        class="text-sm tracking-wider mb-4"
        style="color: var(--text-muted); font-family: var(--font-sans);"
      >
        数字诗集 · 记录 · 观察
      </p>
      <hr class="construct-hr" />
    </div>

    <!-- Self introduction -->
    <!-- 修改自我介绍：直接编辑下方 <p> 标签内的文字即可 -->
    <section class="mb-16">
      <h2 class="about-section-title">
        关于
      </h2>
      <div style="font-family: var(--font-serif); color: var(--text-secondary); line-height: 1.75; font-size: 1.05rem;">
        <p>
          这只是一个静谧的数字空间，用来存放一些文字、一些昼夜、一些被风吹散的念头。
        </p>
        <p>
          我相信思绪应该被记录，文字应该被记录。
          这里是一片净土。
          你可以在任何时刻来到这里，像走进一间夏夜里亮着灯的房间，坐下来，听一首歌，读一段话。
        </p>
        <p>
          所有的文章都是写给未来自己的信。
          如果你碰巧读到，希望能为你带来一点宁静。
        </p>
      </div>
    </section>

    <!-- Social links -->
    <!-- 修改社交链接：增删下方 <a> 元素即可。href 为链接地址，标签文字直接修改。
         注意：Email 链接需使用 mailto: 前缀，例如 href="mailto:xxx@example.com" -->
    <section>
      <h2 class="about-section-title">
        链接
      </h2>
      <div class="about-links-row">
        <a href="https://github.com/SummeriseEscape" class="about-link-item">
          GitHub
        </a>
        <a href="https://twitter.com/" class="about-link-item">
          推特
        </a>
        <a href="https://www.zhihu.com/people/14-66-55-59" class="about-link-item">
          知乎
        </a>
        <a href="mailto:3467328673@qq.com" class="about-link-item">
          Email
        </a>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .about-diagonal {
    position: absolute;
    top: -20%;
    right: -5%;
    width: 1px;
    height: 140%;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--breeze-blue) 20%,
      var(--deep-sky) 80%,
      transparent
    );
    transform: rotate(15deg);
    opacity: 0.1;
    pointer-events: none;
  }
</style>
